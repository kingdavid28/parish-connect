# Saint Raphael Archangel Parish — branding build profile (no secrets).
# Build with: npm run build:san-raphael   (Vite auto-loads .env.san-raphael)
# VITE_API_BASE_URL is intentionally not committed — set it in the
# Cloudflare Pages dashboard (or locally in .env.san-raphael.local).

VITE_PARISH_ID=san-raphael-kawayan
VITE_PARISH_NAME=Saint Raphael Archangel Parish
VITE_PARISH_SHORT_NAME=St. Raphael
VITE_PARISH_LOCATION=Kawayan, Biliran
VITE_PARISH_TAGLINE=Faith. Community. Service.
VITE_ACCENT_COLOR="#16a34a"

# Assets in public/brands/san-raphael/ (logo.png + icon-192/512.png are
# generated by scripts/prepare-parish-assets.ps1 from logo.jpg)
VITE_LOGO_URL=brands/san-raphael/logo.png
VITE_PWA_ICON=brands/san-raphael/icon

# Root deployment (Cloudflare Pages). Use "/parish-connect" style value
# only if hosting under a subfolder.
VITE_BASE_PATH=/
