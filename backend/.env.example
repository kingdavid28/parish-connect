# ── Parish Connect API — environment template ────────────────────────────────
# Copy to backend/.env and fill in. Every parish instance gets its own .env.

# PostgreSQL / CockroachDB connection string
#   CockroachDB Serverless: postgresql://USER:PASSWORD@HOST:26257/DBNAME?sslmode=verify-full
DATABASE_URL=postgresql://user:password@cluster-host.cockroachlabs.cloud:26257/parish_connect?sslmode=verify-full

# Server
PORT=3000
# Public URL where the frontend lives (used in emails / push click targets)
APP_URL=https://your-parish-app.pages.dev
# Base path if app is under a subfolder (e.g. /parish-connect). Empty when at domain root.
APP_BASE_PATH=
# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://your-parish-app.pages.dev

# Auth — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_SECONDS=604800

# Web Push / VAPID — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@yourparish.com

# Email (SMTP) — e.g. Brevo free tier, Gmail app password, Hostinger SMTP
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=noreply@yourparish.com
MAIL_FROM_NAME=Parish Connect

# Auto-post cron — free Groq API key from https://console.groq.com (optional;
# empty falls back to built-in templates). CRON_SECRET guards the endpoint.
GROQ_API_KEY=
CRON_SECRET=generate_a_long_random_string

# ── Parish branding (served to the app via GET /api/config) ──────────────────
PARISH_ID=your-parish-slug
PARISH_NAME=Your Parish Name
PARISH_SHORT_NAME=Your Parish
PARISH_LOCATION=Town, Province
PARISH_TAGLINE=Your parish community app
# Accent color drives buttons, badges, QR header, PWA theme color
PARISH_ACCENT_COLOR=#2563eb
# Public URLs — upload the logo to R2 or the frontend's public/ folder
PARISH_LOGO_URL=
PARISH_BACKGROUND_URL=
# Used by the auto-post cron's AI prompt and hashtags
PARISH_HASHTAGS=#ParishConnect
PARISH_LANGUAGE_NOTES=Write in a mix of Cebuano (Bisaya) and English, the way locals actually speak.

# GCash parish payee info — shown to users for manual GBless top-up.
# GCASH_QR_URL may point at the frontend's public assets, e.g.
#   https://your-parish-app.pages.dev/brands/san-raphael/gcash-qr.jpg
# or an R2 public URL. Note: GCash QR images mask the number — the parish
# must supply the full GCASH_NUMBER/GCASH_NAME separately.
GCASH_NUMBER=09XXXXXXXXX
GCASH_NAME=Parish Name Here
GCASH_QR_URL=

# ── Feature flags ────────────────────────────────────────────────────────────
# internal = sacramental records live in this database (admin-entered)
# off      = Records page hidden
RECORDS_MODE=internal
FEATURE_WALLET=1
FEATURE_REWARDS=1
# 1 = new signups must match a sacramental record (name + father first name).
# 0 = open registration (useful before records are digitized).
VERIFY_PARISH_RECORDS=1

# ── Cloudflare R2 file storage (avatars, images, receipts) ───────────────────
# R2 dashboard → bucket → Manage R2 API Tokens. Public URL = bucket's
# public r2.dev URL or your custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parish-connect-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Seed admin (used by npm run seed-admin, or pass --email/--password) ──────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Administrator
